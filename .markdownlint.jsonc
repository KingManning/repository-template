{
  // Only enable rules that provide practical value.
  "default": false,

  // Heading structure
  "MD001": {
    // Do not treat an OKF YAML title as an implicit H1.
    "front_matter_title": ""
  },
  "MD003": {
    "style": "atx"
  },
  "MD018": true,
  "MD019": true,
  "MD022": true,
  "MD023": true,
  "MD024": {
    // Permit repeated headings under different parent sections.
    "siblings_only": true
  },
  // OKF concepts use YAML titles and may use multiple H1 section headings.
  "MD025": false,

  // Lists
  "MD004": {
    // Preserve an established marker within each file without forcing bundle-wide churn.
    "style": "consistent"
  },
  "MD005": true,
  "MD007": {
    "indent": 2
  },
  "MD029": {
    // Require 1, 2, 3 rather than using "1." for every item.
    "style": "ordered"
  },
  "MD030": true,
  "MD032": true,

  // Whitespace and file cleanliness
  "MD009": true,
  "MD010": {
    // Do not complain about tabs inside copied code examples.
    "code_blocks": false
  },
  "MD011": true,
  "MD012": {
    "maximum": 1
  },
  "MD047": true,

  // Links
  "MD034": true,
  "MD039": true,
  "MD042": true,
  "MD051": true,
  "MD052": true,
  "MD059": true,

  // Code blocks
  "MD031": true,
  "MD038": true,
  "MD040": true,
  "MD046": {
    "style": "fenced"
  },
  "MD048": {
    "style": "backtick"
  },

  // Images and tables
  "MD045": true,
  "MD056": true,
  "MD058": true
}
