{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/v0.23.0/schema/markdownlint-cli2-config-schema.json",

  // Adapt these globs if the project stores Markdown in other hidden folders.
  "globs": [
    "**/*.{md,markdown}",
    ".github/**/*.{md,markdown}",
    ".okf/**/*.{md,markdown}"
  ],
  // Add project-specific dependency or generated-output folders as needed.
  "ignores": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/.venv/**",
    "**/.pytest_cache/**",
    "**/bin/**",
    "**/obj/**",
    "**/build/**",
    "**/dist/**",
    "**/coverage/**"
  ]
}
