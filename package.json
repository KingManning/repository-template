{
  "name": "repository-template",
  "private": true,
  "scripts": {
    "lint": "npm run lint:links && npm run lint:markdown",
    "lint:fix": "npm run lint:links:fix && npm run lint:markdown:fix",
    "lint:links": "py scripts/fix_markdown_links.py",
    "lint:links:fix": "py scripts/fix_markdown_links.py --write",
    "lint:markdown": "markdownlint-cli2",
    "lint:markdown:fix": "markdownlint-cli2 --fix"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.0"
  }
}
